APP_ENV=development
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
ALLOWED_EMAIL_DOMAIN=iitp.ac.in
DATABASE_URL=sqlite:///./academe.db
OTP_TTL_MINUTES=10

# Use an SMTP account you control. Do not commit real credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Creates the first administrator at server startup. Change these before production.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Academe Administrator

# Local-only testing account. Never enable this in production.
DEMO_MODE=false
DEMO_USER_EMAIL=demo.student@iitp.ac.in
DEMO_USER_PASSWORD=
